NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fundi:fundi@localhost:5432/fundi_dev
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Set to "true" to force Secure cookies locally (needs https). In
# production Secure is forced automatically for cross-site cookies.
COOKIE_SECURE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOG_LEVEL=info

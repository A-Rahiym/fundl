generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  client
  artisan
  both
}

enum Locale {
  en
  ha
  yo
  ig
  pcm
}

enum RateType {
  hourly
  fixed
  negotiable
}

enum JobStatus {
  open
  in_progress
  completed
  cancelled
}

enum OfferStatus {
  pending
  accepted
  declined
  withdrawn
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            Role
  phone           String?
  locale          Locale    @default(en)
  locationText    String?   @map("location_text")
  latitude        Float?
  longitude       Float?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  artisanProfile   ArtisanProfile?
  postedJobs        Job[]             @relation("ClientJobs")
  offersSent         Offer[]
  reviewsWritten       Review[]        @relation("ReviewsWritten")
  reviewsReceived        Review[]      @relation("ReviewsReceived")
  notifications           Notification[]

  @@map("users")
}

model Category {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  icon       String?
  sortOrder  Int      @default(0) @map("sort_order")

  artisanProfiles  ArtisanProfile[]
  jobs              Job[]

  @@map("categories")
}

model ArtisanProfile {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  bio          String?
  categoryId   Int       @map("category_id")
  rateType     RateType  @map("rate_type")
  rateAmount   Decimal?  @map("rate_amount") @db.Decimal(12, 2)
  isAvailable  Boolean   @default(true) @map("is_available")
  isVerified   Boolean   @default(false) @map("is_verified")
  avgRating    Decimal   @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount  Int       @default(0) @map("review_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category           @relation(fields: [categoryId], references: [id])
  portfolio   PortfolioImage[]
  stamps      ArtisanStamp[]

  @@map("artisan_profiles")
}

model PortfolioImage {
  id                 String    @id @default(uuid())
  artisanProfileId   String    @map("artisan_profile_id")
  imageUrl           String    @map("image_url")
  caption             String?
  createdAt            DateTime @default(now()) @map("created_at")

  artisanProfile  ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  @@map("portfolio_images")
}

model Job {
  id                 String     @id @default(uuid())
  clientId           String     @map("client_id")
  title               String
  description           String
  categoryId              Int      @map("category_id")
  locationText              String?  @map("location_text")
  latitude                    Float?
  longitude                     Float?
  budgetMin                       Decimal? @map("budget_min") @db.Decimal(12, 2)
  budgetMax                         Decimal? @map("budget_max") @db.Decimal(12, 2)
  preferredDate                       DateTime? @map("preferred_date") @db.Date
  photoUrl                              String?   @map("photo_url")
  status                                  JobStatus @default(open)
  acceptedOfferId                          String?   @unique @map("accepted_offer_id")
  createdAt                                  DateTime  @default(now()) @map("created_at")
  updatedAt                                    DateTime  @updatedAt @map("updated_at")

  client          User      @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Cascade)
  category        Category  @relation(fields: [categoryId], references: [id])
  offers          Offer[]   @relation("JobOffers")
  acceptedOffer   Offer?    @relation("AcceptedOffer", fields: [acceptedOfferId], references: [id])
  review          Review?

  @@map("jobs")
  @@index([status, categoryId])
}

model Offer {
  id          String       @id @default(uuid())
  jobId       String       @map("job_id")
  artisanId   String       @map("artisan_id")
  price       Decimal      @db.Decimal(12, 2)
  message     String?
  status      OfferStatus  @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at")

  job              Job     @relation("JobOffers", fields: [jobId], references: [id], onDelete: Cascade)
  artisan          User    @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  acceptedOnJob    Job?    @relation("AcceptedOffer")

  @@unique([jobId, artisanId])
  @@map("offers")
  @@index([jobId])
}

model Review {
  id           String    @id @default(uuid())
  jobId        String    @unique @map("job_id")
  reviewerId   String    @map("reviewer_id")
  revieweeId   String    @map("reviewee_id")
  rating       Int
  comment      String?
  createdAt    DateTime  @default(now()) @map("created_at")

  job        Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewer   User   @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee   User   @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model ArtisanStamp {
  id                 String    @id @default(uuid())
  artisanProfileId   String    @map("artisan_profile_id")
  stampKey           String    @map("stamp_key")
  earnedAt           DateTime  @default(now()) @map("earned_at")

  artisanProfile  ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Cascade)

  @@unique([artisanProfileId, stampKey])
  @@map("artisan_stamps")
}

model Notification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String
  payload     Json?
  isRead      Boolean   @default(false) @map("is_read")
  createdAt   DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId, isRead])
}
